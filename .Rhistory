arrange(desc(Rating)) %>%
head(5)
print("Top 5 Ranked Movies:")
print(top_rated_movies)
#Bottom 5 ranked movies
lowest_rated_movies <- combined_movie_data %>%
arrange(Rating) %>%
head(5)
print("Bottom 5 Ranked Movies:")
print(lowest_rated_movies)
