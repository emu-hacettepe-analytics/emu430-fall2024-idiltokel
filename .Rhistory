newpolls_us_election2016 <- polls_us_election_2016
for (i in 1:length(newpolls_us_election2016)) {
if (is.numeric(newpolls_us_election2016[[i]])) {
newpolls_us_election2016[[i]][is.na(newpolls_us_election2016[[i]])] <- 2001
} else if (is.character(newpolls_us_election2016[[i]])) {
newpolls_us_election2016[[i]][is.na(newpolls_us_election2016[[i]])] <- idil
}
}
