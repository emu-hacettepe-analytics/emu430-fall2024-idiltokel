library(stringr)
library(ggplot2)
# Define the film links
film_links <- c(
"https://m.imdb.com/search/title/?title_type=feature&release_date=2010-01-01,2023-12-31&num_votes=2500,&country_of_origin=TR&count=250",
"https://m.imdb.com/search/title/?title_type=feature&release_date=,2009-12-31&num_votes=2500,&country_of_origin=TR&count=250"
)
# Scraping function
fetch_movie_details <- function(link) {
page_content <- read_html(link)
# Extract movie titles using your provided method
title_names <- page_content %>% html_nodes('.ipc-title__text') %>% html_text()
title_names <- tail(head(title_names, -1), -1)  # Remove unnecessary first and last elements
title_names <- str_split(title_names, " ", n = 2)  # Split the titles based on space
title_names <- unlist(lapply(title_names, function(x) {x[2]}))  # Take the second part
# Extract years (adjust the CSS selectors based on the current webpage structure)
release_years <- page_content %>%
html_nodes(".sc-16ede01-2") %>%  # Adjust CSS class for year (check if this works)
html_text() %>%
str_extract("\\d{4}") %>%
as.numeric()
# Extract durations (adjust for duration class)
movie_durations <- page_content %>%
html_nodes(".sc-16ede01-4") %>%  # Adjusted CSS class for duration
html_text() %>%
str_extract("\\d+") %>%
as.numeric()
# Extract IMDb ratings (adjust for IMDb rating class)
imdb_scores <- page_content %>%
html_nodes(".sc-16ede01-6") %>%  # Adjusted CSS class for IMDb score
html_text() %>%
as.numeric()
# Extract user ratings (adjust for user rating class)
user_ratings <- page_content %>%
html_nodes(".sc-16ede01-7") %>%  # Adjusted CSS class for user ratings
html_text() %>%
str_remove_all("[^0-9]") %>%
as.numeric()
# Equalize lengths if necessary
max_len <- max(length(title_names), length(release_years), length(movie_durations), length(imdb_scores), length(user_ratings))
title_names <- rep(title_names, length.out = max_len)
release_years <- rep(release_years, length.out = max_len)
movie_durations <- rep(movie_durations, length.out = max_len)
imdb_scores <- rep(imdb_scores, length.out = max_len)
user_ratings <- rep(user_ratings, length.out = max_len)
# Create a data frame (tibble)
movie_dataset <- tibble(
Movie_Title = title_names,
Release_Year = release_years,
Movie_Duration = movie_durations,
Movie_Rating = imdb_scores,
Vote_Count = user_ratings
)
return(movie_dataset)
}
# Fetch data from the two URLs
recent_films <- fetch_movie_details(film_links[1])
older_films <- fetch_movie_details(film_links[2])
# Combine the data
combined_films <- bind_rows(recent_films, older_films)
# Print the first 6 rows of the dataset
print(head(combined_films))
# Top 5 highest-rated movies
top_rated_films <- combined_films %>%
arrange(desc(Movie_Rating)) %>%
head(5)
print("Top 5 Highest-Rated Movies:")
print(top_rated_films)
# Top 5 lowest-rated movies
lowest_rated_films <- combined_films %>%
arrange(Movie_Rating) %>%
head(5)
print("Top 5 Lowest-Rated Movies:")
print(lowest_rated_films)
# Average rating and total movie count by year
film_summary <- combined_films %>%
group_by(Release_Year) %>%
mutate(Average_Rating = mean(Movie_Rating, na.rm = TRUE), Movie_Count = n())
# Average rating by year (column plot)
rating_by_year_column_plot <- film_summary %>%
ggplot(aes(x = Release_Year, y = Average_Rating)) +
geom_col() +
theme_minimal() +
labs(title = "Average Rating by Year", x = "Year", y = "Average Rating")
print(rating_by_year_column_plot)
# Average rating by year (point plot)
rating_by_year_point_plot <- film_summary %>%
ggplot(aes(x = Release_Year, y = Average_Rating)) +
geom_point() +
theme_minimal() +
labs(title = "Average Rating by Year (Point)", x = "Year", y = "Average Rating")
print(rating_by_year_point_plot)
# Rating distribution by year (boxplot)
rating_distribution_by_year_box_plot <- film_summary %>%
ggplot(aes(x = Release_Year, y = Movie_Rating)) +
geom_boxplot() +
theme_minimal() +
labs(title = "Rating Distribution by Year", x = "Year", y = "Rating")
print(rating_distribution_by_year_box_plot)
library(dslabs)
library(tidyverse)
library(rvest)
library(stringr)
# Define movie links
film_links <- c(
"https://m.imdb.com/search/title/?title_type=feature&release_date=2010-01-01,2023-12-31&num_votes=2500,&country_of_origin=TR&count=250",
"https://m.imdb.com/search/title/?title_type=feature&release_date=,2009-12-31&num_votes=2500,&country_of_origin=TR&count=250"
)
# Function to convert movie duration to minutes(I got AI help here)
convert_to_minutes <- function(duration_str) {
hours <- as.integer(str_extract(duration_str, "\\d+(?=h)"))  # Extract hours
minutes <- as.integer(str_extract(duration_str, "\\d+(?=m)"))  # Extract minutes
if (is.na(hours) && is.na(minutes)) return(NA)
total_minutes <- ifelse(!is.na(hours), hours * 60, 0) + ifelse(!is.na(minutes), minutes, 0)
return(total_minutes)
}
# Initialize empty dataframe for storing movie data
movie_data <- data.frame(
Title = character(),
Year = integer(),
Duration = numeric(),
Rating = numeric(),
Votes = numeric(),
stringsAsFactors = FALSE
)
# Function to scrape data from a given URL
scrape_movie_data <- function(url) {
page <- read_html(url)
# Extract the movie titles
title_names <- page |> html_nodes('.ipc-title__text') |> html_text() |> tail(head(., -1), -1)
title_names <- str_split(title_names, " ", n = 2) |> lapply(function(x) x[2]) |> unlist()
# Extract years
years <- page |> html_nodes('.dli-title-metadata-item:nth-child(1)') |> html_text() |> substring(1, 4) |> as.numeric()
# Extract ratings
rating_data <- page |> html_nodes('.ratingGroup--imdb-rating') |> html_text() |> str_extract("\\d+\\.\\d+") |> as.numeric()
# Extract durations and convert to minutes
durations <- page |> html_nodes('.dli-title-metadata-item:nth-child(2)') |> html_text() |> sapply(convert_to_minutes)
# Extract vote counts
votes <- page |> html_nodes('.cyGaqI') |> html_text() |> gsub("Votes", "", .) |> gsub(",", "", .) |> as.numeric()
# Combine all extracted data into a data frame
current_data <- data.frame(Title = title_names, Year = years, Duration = durations, Rating = rating_data, Votes = votes)
return(current_data)
}
# Loop through each URL and scrape data
for (url in links) {
current_data <- scrape_movie_data(url)
# Only add data if there are no missing values
if (!any(is.na(current_data))) {
movie_data <- bind_rows(movie_data, current_data)
} else {
warning("Skipping data with missing values.")
}
}
