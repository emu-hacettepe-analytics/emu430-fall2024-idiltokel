library(dslabs)
library(tidyverse)
library(rvest)
library(stringr)
library(ggplot2)
# URLs for scraping
film_links <- c(
"https://m.imdb.com/search/title/?title_type=feature&release_date=2010-01-01,2023-12-31&num_votes=2500,&country_of_origin=TR&count=250",
"https://m.imdb.com/search/title/?title_type=feature&release_date=,2009-12-31&num_votes=2500,&country_of_origin=TR&count=250"
)
# Create empty lists to store the data
titles <- list()
years <- list()
urls_list <- list()
# Loop through each URL and scrape the data(I got AI help in this section)
for (url in film_links) {
# Read the HTML content of the page
page <- read_html(url)
# Extract movie titles
titles_on_page <- page %>%
html_nodes(".lister-item-header a") %>%
html_text()
# Extract movie release years
years_on_page <- page %>%
html_nodes(".lister-item-year") %>%
html_text()
# Extract movie URLs
urls_on_page <- page %>%
html_nodes(".lister-item-header a") %>%
html_attr("href") %>%
paste0("https://m.imdb.com", .)  # Combine base URL with relative path
# Store the data
titles <- c(titles, titles_on_page)
years <- c(years, years_on_page)
urls_list <- c(urls_list, urls_on_page)
}
# Combine the data into a data frame
movies_df <- data.frame(
Title = titles,
Year = years,
URL = urls_list
)
