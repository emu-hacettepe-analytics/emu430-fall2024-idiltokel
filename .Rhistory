library(rvest)
library(dplyr)
library(dslabs)
library(tidyverse)
library(rvest)
library(stringr)
library(ggplot2)
library(ggplot2)
# Let's scrape data from IMDb for Turkish films
url1 <- "https://www.imdb.com/search/title/?title_type=feature&release_date=2010-01-01,2023-12-31&num_votes=2500,&country_of_origin=TR&count=250"
url2 <- "https://www.imdb.com/search/title/?title_type=feature&release_date=,2009-12-31&num_votes=2500,&country_of_origin=TR&count=250"
urls <- c(url1, url2)
# Empty vectors for data
film_names <- c()
film_years <- c()
film_durations <- c()
film_ratings <- c()
film_votes <- c()
# Web scraping part
for (url in urls) {
page <- read_html(url)
# Get the movie names
names <- page %>% html_nodes('.ipc-title__text') %>% html_text()
names <- tail(head(names, -1), -1)  # Remove first and last element
names <- gsub("\\s*\\([^\\)]+\\)", "", names)  # Remove text inside parentheses
# Get the years
years <- page %>% html_nodes(".sc-43986a27-7.dBkaPT.dli-title-metadata") %>% html_text()
years <- substr(years, 1, 4)  # Extract only the year
# Get the durations
durations <- page %>% html_nodes(".sc-43986a27-7.dBkaPT.dli-title-metadata") %>% html_text()
durations <- gsub("[^0-9]", "", durations)  # Keep only numbers
durations <- as.numeric(durations)  # Convert to numeric
# Get the ratings
ratings <- page %>% html_nodes(".ipc-rating-star.ipc-rating-star--base.ipc-rating-star--imdb.ratingGroup--imdb-rating") %>% html_text()
ratings <- as.numeric(substr(ratings, 1, 3))  # Get the rating
# Get the number of votes
votes <- page %>% html_nodes(".sc-53c98e73-0.kRnqtn") %>% html_text()
votes <- as.numeric(gsub(",", "", votes))  # Remove commas and convert to number
# Append the data to vectors
film_names <- c(film_names, names)
film_years <- c(film_years, years)
film_durations <- c(film_durations, durations)
film_ratings <- c(film_ratings, ratings)
film_votes <- c(film_votes, votes)
}
